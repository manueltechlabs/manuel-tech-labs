---
import BaseLayout from '@/app/layouts/base-layout.astro';
import HeadingBlock from '@/components/layout/heading-block.astro';


const title = 'About Me';
const description =
  "";







import WhatIDoSection from '@/components/sections/what-i-do-section.astro';
const skills = [
  {
    title: "Back-End",
    description: "Java, Spring Boot, Spring Security, REST APIs",
    icon: '/icons/WhatIDo/server-rack-svgrepo-com.svg',
  },
  {
    title: "Front-End",
    description: "React, JavaScript, HTML, CSS",
    icon: '/icons/WhatIDo/code-svgrepo-com.svg',
  },
  {
    title: "Databases",
    description: "SQL (MSSQL, PostgreSQL, HanaSQL), Database Design",
    icon: '/icons/WhatIDo/database-svgrepo-com.svg',
  },
  {
    title: "Data Science",
    description: "Python (Pandas, Scikit-learn), R, Machine Learning, Tableau",
    icon: '/icons/WhatIDo/brain-svgrepo-com.svg',
  },
  {
    title: "DevOps & Cloud",
    description: "AWS, Docker, Git, CI/CD, Automated Testing",
    icon: '/icons/WhatIDo/cloud-svgrepo-com.svg',
  }
];

---

<BaseLayout
  title={title}
  description={description}>
  <main class='main mt-10'>
    <HeadingBlock title="About Me"
    descriptionItems={["Welcome to my digital lab!", "I'm a Backend Engineer specialising in Java and Spring Boot, with a background in Industrial Engineering, Data Science, business systems, and supply chain operations.", "My career has developed at the intersection of technology, data, and business processes. I don't just write code—I aim to build solutions that address real operational and business problems.", " My goal is to translate complex requirements and data into clean, efficient, maintainable software and useful analytical solutions."]} />

    <HeadingBlock title="My Journey: From Process to Code"
    descriptionItems={["My career began in Industrial Engineering, where I worked with supply chains and manufacturing processes and applied methodologies such as Kaizen to improve operations.", "Key Achievement: I managed a full-scale reporting system migration from a legacy ERP to SAP B1, rebuilding all company reports using SQL and Crystal Reports and migrating KPI systems from MSSQL to HanaSQL. This experience gave me a strong understanding of how data, software, ERP systems, and business processes need to work together."]}/>
    
    <HeadingBlock title="Deepening the Tech Stack"
    descriptionItems={["To strengthen my analytical and technical foundation, I completed an MSc in Data Science, developing skills in Python, statistics, machine learning, and data modelling.", "I then focused on modern backend development with Java and Spring Boot, building full-stack applications with REST APIs, authentication, relational databases, automated testing, Docker, and AWS.", "This combination allows me to approach problems from both sides: understanding the business and data behind a problem while also being able to build the software solution."]}/>

    <HeadingBlock title="My Technical Toolkit"/>

    {<WhatIDoSection skills={skills}/>}

    <HeadingBlock title="What I'm Working On Now"
    descriptionItems={["Demand Forecasting System — Developing an end-to-end forecasting application using the M5 retail dataset, combining demand forecasting, data analysis, and my Java/Spring Boot development stack.", "CI/CD & Automated Testing — Implementing automated testing and CI/CD workflows to improve the reliability and deployment process of my applications.", "Full-Stack Business Applications — Continuing development of a CRM platform using Java, Spring Boot, React, MySQL, and Docker, with a focus on real-world business workflows, security, and maintainable architecture.", "Supply Chain Technology — Exploring future projects around warehouse management and supply-chain systems, building on my Industrial Engineering, ERP, and operational background."]}/>

    <HeadingBlock title="Let's Build Something Great"
    descriptionItems={["I'm currently exploring opportunities in Java backend/full-stack development, Data Analytics, Supply Chain Analytics, and Business/ERP Systems.", "I'm particularly interested in roles where software, data, and business processes intersect.", "If you're looking for someone who understands both the technical solution and the business problem behind it, let's connect."]}/>

  </main>
</BaseLayout>

<style>
  .intro-text {
    margin-top: 1rem;
    line-height: 1.6;
  }
  .working-on-title {
  margin-top: 2.5rem;
}
ul {
  list-style: disc;
  padding-left: 1.5rem;
}

li {
  margin-bottom: 0.5rem;
}   

  /* Tech Stack section */


</style>
